<?php
$pdo = new PDO("mysql:host=localhost;dbname=pvamu_registration;charset=utf8", "root", "");

// Fetch Data for Q5: What percentage of seats are filled per course?
$stmt = $pdo->query("
    SELECT c.title, (s.enrolled_count / s.capacity) * 100 as percent_filled
    FROM SECTION s
    JOIN COURSE c ON s.course_id = c.course_id
");
$chart_data = $stmt->fetchAll(PDO::FETCH_ASSOC);

// Prepare data for Javascript
$labels = [];
$data = [];
foreach ($chart_data as $row) {
    $labels[] = $row['title'];
    $data[] = round($row['percent_filled'], 1);
}
?>

