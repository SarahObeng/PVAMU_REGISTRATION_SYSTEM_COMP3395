    <div class="row">
        <div class="col-md-8">
            <div class="card p-4 shadow-sm">
                <h4>Course Enrollment Status (% Filled)</h4>
                <canvas id="enrollmentChart"></canvas>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card p-4 shadow-sm bg-warning text-dark">
                <h5>Under-Enrolled Alerts</h5>
                <ul class="list-group list-group-flush mt-2">
                    <?php 
                    // Dynamic alert for classes under 50%
                    foreach ($chart_data as $row) {
                        if ($row['percent_filled'] < 50) {
                            echo "<li class='list-group-item bg-transparent'>⚠️ " . $row['title'] . " (" . round($row['percent_filled']) . "%)</li>";
                        }
                    }
                    ?>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
// JavaScript to draw the interactive chart
const ctx = document.getElementById('enrollmentChart').getContext('2d');
new Chart(ctx, {
    type: 'bar',
    data: {
        labels: <?= json_encode($labels) ?>,
        datasets: [{
            label: 'Percentage of Seats Filled',
            data: <?= json_encode($data) ?>,
            backgroundColor: 'rgba(62, 43, 86, 0.7)', // PVAMU Purple theme
            borderColor: 'rgba(62, 43, 86, 1)',
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        scales: {
            y: { beginAtZero: true, max: 100 }
        }
    }
});
</script>

